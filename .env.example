# Какая модель отвечает на вопросы: ollama или openai.
LLM_PROVIDER=ollama

# Какая модель строит векторы. Её нельзя менять, не сменив коллекцию
# и не проиндексировав PDF заново: у разных моделей разная размерность.
EMBEDDING_PROVIDER=ollama

# Режим по умолчанию: graph (LangGraph) или chain (короткая цепочка LangChain).
RAG_MODE=graph

# OpenAI. Ключ нужен только если выбран openai для ответов или эмбеддингов.
# OPENAI_BASE_URL можно указать для совместимого шлюза.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Локальная Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_DIMENSIONS=768

# Qdrant.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=studymind_documents

# Поиск.
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.35
MAX_REWRITE_ATTEMPTS=1
LLM_TEMPERATURE=0.1

# Telegram-бот ходит в этот адрес API.
API_BASE_URL=http://127.0.0.1:8000
TELEGRAM_BOT_TOKEN=

MAX_UPLOAD_BYTES=10485760
